rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -------------------------------------------------------------------------
    // GLOBAL HELPERS
    // -------------------------------------------------------------------------
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function authEmail() {
      return isSignedIn() && ('email' in request.auth.token) ? request.auth.token.email.lower() : '';
    }
    
    function isMoritz() {
      return isSignedIn() && (
        request.auth.uid == 'fehEDbG4MDekoD9WMe8xo7HKAdJ2' ||
        authEmail() == 'moritz.menet.bfsu@gmail.com'
      );
    }

    function isGoogleUser() {
      return isSignedIn() && 
             'firebase' in request.auth.token && 
             'sign_in_provider' in request.auth.token.firebase && 
             request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isAppleUser() {
      return isSignedIn() && 
             'firebase' in request.auth.token && 
             'sign_in_provider' in request.auth.token.firebase && 
             request.auth.token.firebase.sign_in_provider == 'apple.com';
    }

    function isBlocked() {
      return !isMoritz() &&
             exists(/databases/$(database)/documents/households/main_household) &&
             'blocked_emails' in get(/databases/$(database)/documents/households/main_household).data &&
             authEmail() != '' &&
             authEmail() in get(/databases/$(database)/documents/households/main_household).data.blocked_emails;
    }
    
    function isVerified() {
      return isSignedIn() && (
        isMoritz() ||
        (
          !isBlocked() && (
            ('email_verified' in request.auth.token && request.auth.token.email_verified == true) || 
            isGoogleUser() ||
            isAppleUser()
          )
        )
      );
    }
    
    function isAdmin() {
      return isSignedIn() && (
        isMoritz() ||
        (
          isVerified() &&
          exists(/databases/$(database)/documents/households/main_household) &&
          'allowed_emails' in get(/databases/$(database)/documents/households/main_household).data &&
          authEmail() != '' &&
          authEmail() in get(/databases/$(database)/documents/households/main_household).data.allowed_emails
        )
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    // -------------------------------------------------------------------------
    // VALIDATION HELPERS
    // -------------------------------------------------------------------------

    function isValidHousehold(data) {
      return 'household_name' in data && data.household_name is string && data.household_name.size() <= 100;
    }

    function isValidMember(data) {
      return 'id' in data && data.id is string && 
             'name' in data && data.name is string && 
             'role' in data && data.role in ['admin', 'member'];
    }

    function isValidTask(data) {
      return 'id' in data && data.id is string && 
             'title' in data && data.title is string && 
             'base_points' in data && data.base_points is number;
    }

    function isValidLog(data) {
      return 'log_id' in data && data.log_id is string && 
             'task_id' in data && data.task_id is string && 
             'user_id' in data && data.user_id is string &&
             'points_awarded' in data && data.points_awarded is number &&
             'timestamp' in data && data.timestamp is string;
    }

    function isValidPinnwandNote(data) {
      return ('id' in data && data.id is string) &&
             ('content' in data && data.content is string && data.content.size() <= 5000) &&
             ('color' in data && data.color in ['yellow', 'pink', 'blue', 'green', 'orange', 'purple']) &&
             ('authorId' in data && data.authorId is string) &&
             ('authorName' in data && data.authorName is string);
    }

    // -------------------------------------------------------------------------
    // SECURITY RULES
    // -------------------------------------------------------------------------

    // Households
    match /households/{householdId} {
      allow read: if isVerified();
      
      // Allow creation if Moritz or Verified user (if bootstrap is needed)
      allow create: if isVerified() && (isMoritz() || !exists(/databases/$(database)/documents/households/main_household));
      
      // Allow update if Admin or Moritz
      allow update: if isVerified() && (isMoritz() || isAdmin());
      
      allow delete: if isMoritz();

      // Members Subcollection
      match /members/{memberId} {
        allow read: if isVerified();
        allow create, update: if isVerified() && (isMoritz() || isValidMember(incoming()));
        allow delete: if isAdmin();
      }

      // Tasks Subcollection
      match /tasks/{taskId} {
        allow read: if isVerified();
        allow create, update: if isVerified() && (isMoritz() || isValidTask(incoming()));
        allow delete: if isVerified();
      }

      // Logs Subcollection
      match /logs/{logId} {
        allow read: if isVerified();
        allow create, update: if isVerified() && (isMoritz() || isValidLog(incoming()));
        allow delete: if isAdmin();
      }

      // Pinnwand Subcollection (Notes, Threads, Polls, Reactions)
      match /pinnwand/{noteId} {
        allow read: if isVerified();
        allow create, update: if isVerified() && (isMoritz() || isValidPinnwandNote(incoming()));
        allow delete: if isVerified();
      }
    }

    // Sessions Collection (Top level)
    match /sessions/{sessionId} {
      allow read: if isAdmin();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin() || isMoritz();
    }

    // Public Test Collection (for connectivity checks)
    match /test/{testId} {
      allow read, write: if isSignedIn();
    }
  }
}
