rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Household access: allow all signed-in users to read and write
    match /households/{householdId} {
      allow read, write: if request.auth != null;
      
      // Subcollections (members, tasks, logs, etc.)
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null;
      }
    }

    // Allow connection test
    match /test/connection {
      allow read: if true;
    }
    
    // Explicitly allow seeding if document doesn't exist
    match /{path=**} {
      allow read, write: if request.auth != null;
    }
  }
}
