rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'moritz.menet.bfsu@gmail.com';
    }

    function isAllowed(householdId) {
      let household = get(/databases/$(database)/documents/households/$(householdId));
      return isSignedIn() && (
        isAdmin() || 
        (household.data.allowed_emails != null && request.auth.token.email in household.data.allowed_emails)
      );
    }

    match /households/{householdId} {
      allow read, write: if isSignedIn() && (
        isAdmin() || 
        resource == null || 
        (resource.data.allowed_emails != null && request.auth.token.email in resource.data.allowed_emails)
      );
      
      match /{allSubcollections=**} {
        allow read, write: if isAllowed(householdId);
      }
    }

    // Allow connection test
    match /test/connection {
      allow read: if true;
    }
  }
}
