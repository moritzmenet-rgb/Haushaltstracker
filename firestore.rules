rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -------------------------------------------------------------------------
    // GLOBAL HELPERS
    // -------------------------------------------------------------------------
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function authEmail() {
      return isSignedIn() && request.auth.token.get('email', '') != '' ? request.auth.token.email.lower() : '';
    }
    
    function isMoritz() {
      return isSignedIn() && (
        request.auth.uid == 'fehEDbG4MDekoD9WMe8xo7HKAdJ2' ||
        authEmail() == 'moritz.menet.bfsu@gmail.com'
      );
    }

    function isGoogleUser() {
      return isSignedIn() && request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'google.com';
    }

    function isAppleUser() {
      return isSignedIn() && request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'apple.com';
    }

    function isBlocked() {
      return exists(/databases/$(database)/documents/households/main_household) &&
             authEmail() != '' &&
             authEmail() in get(/databases/$(database)/documents/households/main_household).data.get('blocked_emails', []);
    }
    
    function isVerified() {
      return isSignedIn() && !isBlocked() && (
        request.auth.token.get('email_verified', false) == true || 
        isGoogleUser() ||
        isAppleUser() ||
        isMoritz()
      );
    }
    
    function isAdmin() {
      return isVerified() && (
        isMoritz() ||
        (exists(/databases/$(database)/documents/households/main_household) && 
         authEmail() in get(/databases/$(database)/documents/households/main_household).data.get('allowed_emails', []))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    // -------------------------------------------------------------------------
    // VALIDATION HELPERS
    // -------------------------------------------------------------------------

    function isValidHousehold(data) {
      return data.get('household_name', '') is string && 
             data.get('household_name', '').size() <= 100 &&
             data.get('default_weekly_target', 0) is number;
    }

    function isValidMember(data) {
      return data.get('id', '') is string && 
             data.get('name', '') is string && 
             data.get('role', '') in ['admin', 'member'];
    }

    function isValidTask(data) {
      return data.get('id', '') is string && 
             data.get('title', '') is string && 
             data.get('base_points', 0) is number;
    }

    function isValidLog(data) {
      return data.get('log_id', '') is string && 
             data.get('task_id', '') is string && 
             data.get('user_id', '') is string &&
             data.get('points_awarded', 0) is number &&
             data.get('timestamp', '') is string;
    }

    // -------------------------------------------------------------------------
    // SECURITY RULES
    // -------------------------------------------------------------------------

    // Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Households
    match /households/{householdId} {
      allow read: if isVerified();
      
      // Allow creation if Moritz or Verified user (if bootstrap is needed)
      allow create: if isVerified() && (isMoritz() || !exists(/databases/$(database)/documents/households/main_household));
      
      // Allow update if Admin or Moritz
      allow update: if isVerified() && (isMoritz() || isAdmin());
      
      allow delete: if isMoritz();

      // Members Subcollection
      match /members/{memberId} {
        allow read: if isVerified();
        allow create, update: if isVerified() && isValidMember(incoming());
        allow delete: if isAdmin();
      }

      // Tasks Subcollection
      match /tasks/{taskId} {
        allow read: if isVerified();
        allow create, update: if isVerified() && isValidTask(incoming());
        allow delete: if isAdmin();
      }

      // Logs Subcollection
      match /logs/{logId} {
        allow read: if isVerified();
        allow create, update: if isVerified() && isValidLog(incoming());
        allow delete: if isAdmin();
      }
    }

    // Sessions Collection (Top level)
    match /sessions/{sessionId} {
      allow read: if isAdmin();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin() || isMoritz();
    }

    // Public Test Collection (for connectivity checks)
    match /test/{testId} {
      allow read, write: if isSignedIn();
    }
  }
}
