rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -------------------------------------------------------------------------
    // GLOBAL HELPERS & AUTHENTICATION GATES
    // -------------------------------------------------------------------------
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function authEmail() {
      return isSignedIn() && ('email' in request.auth.token) && request.auth.token.email != null 
        ? request.auth.token.email.lower() 
        : '';
    }
    
    // Full admins. Add further admin accounts to this list (email, Google sign-in).
    // The e-mail only counts when it comes from a verified Google sign-in: with the
    // e-mail/password provider enabled (Wichteln), anybody could otherwise create an
    // unverified password account that claims an admin address.
    function isMoritz() {
      return isSignedIn() && (
        request.auth.uid == 'fehEDbG4MDekoD9WMe8xo7HKAdJ2' ||
        (isGoogleUser() &&
         request.auth.token.get('email_verified', false) == true &&
         authEmail() in ['moritz.menet.bfsu@gmail.com', 'moritz.menet@gmail.com'])
      );
    }

    function isGoogleUser() {
      return isSignedIn() && 
             'firebase' in request.auth.token && 
             'sign_in_provider' in request.auth.token.firebase && 
             request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isAppleUser() {
      return isSignedIn() && 
             'firebase' in request.auth.token && 
             'sign_in_provider' in request.auth.token.firebase && 
             request.auth.token.firebase.sign_in_provider == 'apple.com';
    }

    function isAnonymousUser() {
      return isSignedIn() && 
             'firebase' in request.auth.token && 
             'sign_in_provider' in request.auth.token.firebase && 
             request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isBlocked() {
      return !isMoritz() &&
             authEmail() != "" &&
             exists(/databases/$(database)/documents/households/main_household) &&
             ("blocked_emails" in get(/databases/$(database)/documents/households/main_household).data) && 
             get(/databases/$(database)/documents/households/main_household).data.blocked_emails.hasAny([authEmail()]);
    }
    
    // -------------------------------------------------------------------------
    // GERAETE-SCHUTZ (device unlock with the family code)
    //   households/main_household/private/access  { code, enforce }  -> Moritz only
    //   households/main_household/devices/{uid}   one doc per unlocked device
    // -------------------------------------------------------------------------

    function accessPath() {
      return /databases/$(database)/documents/households/main_household/private/access;
    }

    function isUnlockedDevice() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/households/main_household/devices/$(request.auth.uid));
    }

    // Database protection switch (Admin > Geraete & Zugang > 3.)
    function isEnforced() {
      return exists(accessPath()) && get(accessPath()).data.get('enforce', false) == true;
    }

    // Who may use the household data:
    //  - Moritz (Google) always
    //  - unlocked devices (unless their e-mail is blocked)
    //  - while protection is NOT enforced yet: everybody who is not blocked (rollout phase)
    function isVerified() {
      return isMoritz() ||
             (isUnlockedDevice() && !isBlocked()) ||
             (!isEnforced() && !isBlocked());
    }

    // Admin rights only for Moritz' Google account
    function isAdmin() {
      return isMoritz();
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    // -------------------------------------------------------------------------
    // VALIDATION HELPERS (NULL-SAFE & COMPREHENSIVE)
    // -------------------------------------------------------------------------

    function isValidHousehold(data) {
      return 'household_name' in data && data.household_name is string && data.household_name.size() <= 100 &&
             (!('default_weekly_target' in data) || data.default_weekly_target is number) &&
             (!('admin_only_settings' in data) || data.admin_only_settings is bool);
    }

    function isValidMember(data) {
      return data.keys().hasAll(['id', 'name', 'role', 'avatar_color']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.role in ['admin', 'member'] &&
             data.avatar_color is string &&
             (!('total_points' in data) || data.total_points is number) &&
             (!('weekly_target' in data) || data.weekly_target is number) &&
             (!('has_seen_tutorial' in data) || data.has_seen_tutorial is bool) &&
             (!('last_seen_version' in data) || data.last_seen_version == null || (data.last_seen_version is string && data.last_seen_version.size() <= 64)) &&
             (!('preferred_theme' in data) || data.preferred_theme == null || (data.preferred_theme is string && data.preferred_theme.size() <= 32)) &&
             (!('preferred_mode' in data) || data.preferred_mode == null || (data.preferred_mode is string && data.preferred_mode.size() <= 32)) &&
             (!('unlocked_badges' in data) || data.unlocked_badges is map) &&
             (!('showroom_badges' in data) || data.showroom_badges is list) &&
             (!('active_badge_id' in data) || data.active_badge_id == null || (data.active_badge_id is string && data.active_badge_id.size() <= 128)) &&
             (!('pin_code' in data) || data.pin_code == null || data.pin_code == '') &&
             (!('pin_hash' in data) || data.pin_hash == null || (data.pin_hash is string && data.pin_hash.size() <= 200)) &&
             (!('haptics_enabled' in data) || data.haptics_enabled is bool) &&
             (!('animations_enabled' in data) || data.animations_enabled is bool) &&
             (!('householdId' in data) || data.householdId is string);
    }

    function isValidTask(data) {
      return data.keys().hasAll(['id', 'title', 'base_points']) &&
             data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.base_points is number &&
             (!('description' in data) || data.description == null || data.description is string) &&
             (!('category' in data) || data.category is string) &&
             (!('estimated_duration' in data) || data.estimated_duration is number) &&
             (!('interval_days' in data) || data.interval_days is number) &&
             (!('frequency_per_day' in data) || data.frequency_per_day is number) &&
             (!('preferred_time' in data) || data.preferred_time == null || data.preferred_time is string) &&
             (!('created_by' in data) || data.created_by is string) &&
             (!('last_done' in data) || data.last_done == null || data.last_done is string) &&
             (!('fished_by' in data) || data.fished_by == null || data.fished_by is string) &&
             (!('fished_until' in data) || data.fished_until == null || data.fished_until is string) &&
             (!('is_pinned' in data) || data.is_pinned is bool) &&
             (!('pinned_bonus_points' in data) || data.pinned_bonus_points is number) &&
             (!('householdId' in data) || data.householdId is string);
    }

    function isValidLog(data) {
      return data.keys().hasAll(['log_id', 'task_id', 'user_id', 'stars', 'points_awarded', 'timestamp']) &&
             data.log_id is string && data.log_id.size() <= 128 &&
             data.task_id is string && data.task_id.size() <= 128 &&
             data.user_id is string && data.user_id.size() <= 128 &&
             data.stars is number &&
             data.points_awarded is number &&
             data.timestamp is string && data.timestamp.size() <= 64 &&
             (!('actual_duration' in data) || data.actual_duration is number) &&
             (!('notes' in data) || data.notes == null || data.notes is string) &&
             (!('householdId' in data) || data.householdId is string);
    }

    function isValidPinnwandNote(data) {
      return data.keys().hasAll(['id', 'content', 'authorId', 'authorName']) &&
             data.id is string &&
             data.content is string && data.content.size() <= 5000 &&
             data.authorId is string &&
             data.authorName is string;
    }

    function isValidMenuWish(data) {
      return data.keys().hasAll(['id', 'title', 'requestedBy']) &&
             data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 500 &&
             data.requestedBy is string && data.requestedBy.size() <= 128;
    }

    function isValidRecipe(data) {
      return data.keys().hasAll(['id', 'title']) &&
             data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 250 &&
             (!('category' in data) || data.category is string) &&
             (!('effort' in data) || data.effort is string) &&
             (!('durationMinutes' in data) || data.durationMinutes is number) &&
             (!('requiresBaking' in data) || data.requiresBaking is bool) &&
             (!('cookingMethod' in data) || data.cookingMethod is string) &&
             (!('ingredients' in data) || data.ingredients is list) &&
             (!('description' in data) || data.description is string) &&
             (!('isVegetarian' in data) || data.isVegetarian is bool) &&
             (!('vegetarianOption' in data) || data.vegetarianOption is string);
    }

    function isValidTaskEdit(data) {
      return data.keys().hasAll(['id', 'task_id', 'edited_by_id', 'edited_by_name', 'timestamp']) &&
             data.id is string && data.id.size() <= 128 &&
             data.task_id is string && data.task_id.size() <= 128 &&
             data.edited_by_id is string && data.edited_by_id.size() <= 128 &&
             data.edited_by_name is string && data.edited_by_name.size() <= 100 &&
             data.timestamp is string && data.timestamp.size() <= 64 &&
             (!('summary' in data) || data.summary is string) &&
             (!('changes' in data) || data.changes is list);
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'type', 'title']) &&
             data.id is string && data.id.size() <= 128 &&
             data.type is string &&
             data.title is string;
    }

    function isValidSession(data) {
      return data.keys().hasAll(['id', 'user_id', 'timestamp']) &&
             data.id is string && data.id.size() <= 128 &&
             data.user_id is string && data.user_id.size() <= 128 &&
             data.timestamp is string && data.timestamp.size() <= 64 &&
             !('ip_address' in data);
    }

    function isValidDevice(data, uid) {
      return data.keys().hasOnly(['uid', 'code', 'label', 'device_type', 'created_at']) &&
             data.uid == uid &&
             data.code is string && data.code.size() == 8 &&
             data.label is string && data.label.size() <= 60 &&
             data.device_type is string && data.device_type.size() <= 20 &&
             data.created_at is string && data.created_at.size() <= 64;
    }

    // -------------------------------------------------------------------------
    // WICHTELN
    // The Wichtel-PIN is checked in the app (family decision, no extra login).
    // The server enforces the structure: wishes are fixed (only the ranking moves),
    // the first claim wins, an assignment is fixed until the admin resets it.
    //   households/{hh}/wichteln_pins/{member}            hashed Wichtel-PIN
    //   households/{hh}/wichteln/{season}/assign/{giver}  whom the giver gifts (exactly 2)
    //   households/{hh}/wichteln/{season}/wishes/{wish}   wish list entries
    //   households/{hh}/wichteln/{season}/claims/{wish}   "Ich besorge das"
    //   households/{hh}/wichteln/{season}/counts/{member} number of wishes (envelopes on the tree)
    // -------------------------------------------------------------------------

    function isShortText(v, max) {
      return v is string && v.size() <= max;
    }

    function isOptionalText(data, key, max) {
      return !(key in data) || data[key] == null || isShortText(data[key], max);
    }

    // "Wie wichtig ist dir das?" 1..5 (optional)
    function isValidPrio(data) {
      return !('prio' in data) || data.prio == null || (data.prio is int && data.prio >= 1 && data.prio <= 5);
    }

    function isValidWish(data, wishId) {
      return data.keys().hasOnly(['id', 'owner_id', 'title', 'price', 'where', 'hint', 'rank', 'prio', 'created_at']) &&
             data.keys().hasAll(['id', 'owner_id', 'title', 'rank', 'created_at']) &&
             data.id == wishId &&
             isShortText(data.owner_id, 128) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             isOptionalText(data, 'price', 40) &&
             isOptionalText(data, 'where', 300) &&
             isOptionalText(data, 'hint', 300) &&
             data.rank is number &&
             isValidPrio(data) &&
             isShortText(data.created_at, 64);
    }

    // member `giverId` gifts `ownerId` this season
    function gives(hh, season, giverId, ownerId) {
      return giverId is string &&
             exists(/databases/$(database)/documents/households/$(hh)/wichteln/$(season)/assign/$(giverId)) &&
             get(/databases/$(database)/documents/households/$(hh)/wichteln/$(season)/assign/$(giverId)).data.receivers.hasAny([ownerId]);
    }

    // -------------------------------------------------------------------------
    // SECURITY RULES (ALL COLLECTIONS & SUBCOLLECTIONS)
    // -------------------------------------------------------------------------

    // Households
    match /households/{householdId} {
      allow read: if isVerified();
      
      // Allow creation if Moritz or Verified user (if bootstrap is needed)
      allow create: if isVerified() && (isMoritz() || !exists(/databases/$(database)/documents/households/main_household));
      
      // Allow update if Verified user and valid household data
      // Access settings (allow/block lists, device lock) can only be changed by Moritz.
      allow update: if isVerified() && isValidHousehold(incoming()) &&
                       (isMoritz() || !incoming().diff(resource.data).affectedKeys()
                         .hasAny(['allowed_emails', 'blocked_emails', 'device_lock_enabled']));
      
      allow delete: if isMoritz();

      // Members Subcollection
      match /members/{memberId} {
        allow read: if isVerified();
        allow create: if isVerified() && (isMoritz() || (isValidMember(incoming()) && incoming().role == 'member'));
        allow update: if isVerified() && (isMoritz() || (isValidMember(incoming()) && incoming().role == resource.data.role));
        allow delete: if isMoritz();
      }

      // Tasks Subcollection
      match /tasks/{taskId} {
        allow read: if isVerified();
        allow create, update: if isVerified() && (isMoritz() || isValidTask(incoming()));
        allow delete: if isVerified();
      }

      // Logs Subcollection
      match /logs/{logId} {
        allow read: if isVerified();
        allow create, update: if isVerified() && (isMoritz() || isValidLog(incoming()));
        allow delete: if isAdmin() || isVerified();
      }

      // Pinnwand Subcollection (Notes, Threads, Polls, Reactions)
      match /pinnwand/{noteId} {
        allow read: if isVerified();
        allow create, update: if isVerified() && (isMoritz() || isValidPinnwandNote(incoming()));
        allow delete: if isVerified();
      }

      // Menuplanner Subcollection (Planned Meals, Wishes & Recipes)
      match /menus/{menuId} {
        allow read: if isVerified();
        allow create, update: if isVerified();
        allow delete: if isAdmin() || isVerified();
      }

      match /recipes/{recipeId} {
        allow read: if isVerified();
        allow create, update: if isVerified();
        allow delete: if isAdmin() || isVerified();
      }

      match /menu_wishes/{wishId} {
        allow read: if isVerified();
        allow create, update: if isVerified();
        allow delete: if isAdmin() || isVerified();
      }

      // Household Notifications Subcollection (Task Pinned & Trophy Stolen)
      match /notifications/{notificationId} {
        allow read: if isVerified();
        allow create, update: if isVerified();
        allow delete: if isVerified();
      }

      // Task Edits & Point Modifications Audit Log
      match /task_edits/{editId} {
        allow read: if isVerified();
        allow create, update: if isVerified() && (isMoritz() || isValidTaskEdit(incoming()));
        allow delete: if isAdmin() || isMoritz();
      }

      // Unlocked devices: a device may only register itself, and only with the correct family code
      match /devices/{deviceId} {
        allow get: if isSignedIn() && (deviceId == request.auth.uid || isMoritz());
        allow list, update, delete: if isMoritz();
        allow create: if isSignedIn() && deviceId == request.auth.uid &&
                         isValidDevice(incoming(), request.auth.uid) &&
                         exists(accessPath()) &&
                         get(accessPath()).data.get('code', '') == incoming().code;
      }

      // Secret access config (family code, protection switch) - nobody but Moritz can read it
      match /private/{docId} {
        allow read, write: if isMoritz();
      }

      // --- WICHTELN: PIN ---------------------------------------------------
      match /wichteln_pins/{memberId} {
        allow read: if isVerified();
        allow create: if isVerified() &&
                         incoming().keys().hasOnly(['member_id', 'pin_hash', 'created_at']) &&
                         incoming().member_id == memberId &&
                         exists(/databases/$(database)/documents/households/$(householdId)/members/$(memberId)) &&
                         isShortText(incoming().pin_hash, 200) &&
                         isShortText(incoming().created_at, 64);
        // "Wichtel-PIN vergessen": only the admin resets it
        allow delete: if isMoritz();
      }

      // --- WICHTELN: one season ---------------------------------------------
      match /wichteln/{season} {

        // Whom the giver gifts. Fixed once saved; only the admin can reset it.
        match /assign/{giverId} {
          allow read: if isVerified();
          allow create: if isVerified() &&
                           incoming().keys().hasOnly(['giver_id', 'receivers', 'created_at']) &&
                           incoming().giver_id == giverId &&
                           exists(/databases/$(database)/documents/households/$(householdId)/members/$(giverId)) &&
                           incoming().receivers is list &&
                           incoming().receivers.size() == 2 &&
                           incoming().receivers[0] != incoming().receivers[1] &&
                           !incoming().receivers.hasAny([giverId]) &&
                           exists(/databases/$(database)/documents/households/$(householdId)/members/$(incoming().receivers[0])) &&
                           exists(/databases/$(database)/documents/households/$(householdId)/members/$(incoming().receivers[1])) &&
                           isShortText(incoming().created_at, 64);
          allow delete: if isMoritz();
        }

        // Wishes can be changed later by anyone verified (the app only offers it to the owner), never deleted.
        match /wishes/{wishId} {
          allow read: if isVerified();
          allow create: if isVerified() &&
                           isValidWish(incoming(), wishId) &&
                           exists(/databases/$(database)/documents/households/$(householdId)/members/$(incoming().owner_id));
          // Everything except id, owner and creation date can change. Never depends on
          // claims: a failing edit would tell the owner.
          allow update: if isVerified() &&
                           incoming().diff(resource.data).affectedKeys().hasOnly(['title', 'price', 'where', 'hint', 'rank', 'prio', 'edited_at']) &&
                           incoming().title is string && incoming().title.size() >= 1 && incoming().title.size() <= 120 &&
                           isOptionalText(incoming(), 'price', 40) &&
                           isOptionalText(incoming(), 'where', 300) &&
                           incoming().rank is number &&
                           isValidPrio(incoming()) &&
                           isOptionalText(incoming(), 'hint', 300) &&
                           isOptionalText(incoming(), 'edited_at', 64);
          allow delete: if false;
        }

        // "Ich besorge das". Doc id = wish id, so the first claim wins
        // (a second create is an update -> denied). Only a Wichtel of the owner can claim.
        match /claims/{wishId} {
          allow read: if isVerified();
          allow create: if isVerified() &&
                           incoming().keys().hasOnly(['wish_id', 'owner_id', 'claimed_by', 'claimed_at', 'with_id']) &&
                           // pooled with the other Wichtel: the partner must gift the owner too
                           (!('with_id' in incoming()) || incoming().with_id == null ||
                             (incoming().with_id != incoming().claimed_by &&
                              incoming().with_id != incoming().owner_id &&
                              gives(householdId, season, incoming().with_id, incoming().owner_id))) &&
                           incoming().wish_id == wishId &&
                           isShortText(incoming().claimed_by, 128) &&
                           incoming().claimed_by != incoming().owner_id &&
                           exists(/databases/$(database)/documents/households/$(householdId)/wichteln/$(season)/wishes/$(wishId)) &&
                           get(/databases/$(database)/documents/households/$(householdId)/wichteln/$(season)/wishes/$(wishId)).data.owner_id == incoming().owner_id &&
                           exists(/databases/$(database)/documents/households/$(householdId)/wichteln/$(season)/assign/$(incoming().claimed_by)) &&
                           get(/databases/$(database)/documents/households/$(householdId)/wichteln/$(season)/assign/$(incoming().claimed_by)).data.receivers.hasAny([incoming().owner_id]) &&
                           isShortText(incoming().claimed_at, 64);
          allow delete: if isVerified();
          allow update: if false;
        }

        // "Zusammenlegen": a Wichtel asks the other Wichtel of the same person to pool on a wish.
        // Doc id = wish id (one request per wish). Only answer once: pending -> accepted/declined.
        match /connects/{wishId} {
          allow read: if isVerified();
          // general "zusammentun" for a person (own idea, no wish): doc id person_{owner}
          allow create: if isVerified() &&
                           wishId == 'person_' + incoming().owner_id &&
                           incoming().keys().hasOnly(['kind', 'owner_id', 'from_id', 'status', 'note', 'created_at']) &&
                           incoming().kind == 'person' &&
                           incoming().status == 'pending' &&
                           isShortText(incoming().from_id, 128) &&
                           incoming().from_id != incoming().owner_id &&
                           gives(householdId, season, incoming().from_id, incoming().owner_id) &&
                           isOptionalText(incoming(), 'note', 300) &&
                           isShortText(incoming().created_at, 64);
          allow create: if isVerified() &&
                           incoming().keys().hasOnly(['wish_id', 'owner_id', 'from_id', 'status', 'created_at']) &&
                           incoming().wish_id == wishId &&
                           incoming().status == 'pending' &&
                           incoming().from_id != incoming().owner_id &&
                           exists(/databases/$(database)/documents/households/$(householdId)/wichteln/$(season)/wishes/$(wishId)) &&
                           get(/databases/$(database)/documents/households/$(householdId)/wichteln/$(season)/wishes/$(wishId)).data.owner_id == incoming().owner_id &&
                           gives(householdId, season, incoming().from_id, incoming().owner_id) &&
                           isShortText(incoming().created_at, 64);
          allow update: if isVerified() &&
                           resource.data.status == 'pending' &&
                           incoming().diff(resource.data).affectedKeys().hasOnly(['status', 'to_id', 'answered_at']) &&
                           incoming().status in ['accepted', 'declined'] &&
                           incoming().to_id != resource.data.from_id &&
                           incoming().to_id != resource.data.owner_id &&
                           gives(householdId, season, incoming().to_id, resource.data.owner_id) &&
                           isShortText(incoming().answered_at, 64);
          allow delete: if isVerified();
        }

        // Number of wishes per member (shown as sealed envelopes on other branches later)
        match /counts/{memberId} {
          allow read: if isVerified();
          allow create, update: if isVerified() &&
                                   incoming().keys().hasOnly(['count']) &&
                                   incoming().count is int && incoming().count >= 0 && incoming().count <= 500;
          allow delete: if false;
        }
      }
    }

    // Sessions Collection (Top level audit log for admin tracking)
    match /sessions/{sessionId} {
      allow read: if isMoritz();
      allow create: if isVerified() && isValidSession(incoming());
      allow update, delete: if isMoritz();
    }

    // Public Test Collection (for connectivity checks)
    match /test/{testId} {
      allow read, write: if isSignedIn();
    }
  }
}
