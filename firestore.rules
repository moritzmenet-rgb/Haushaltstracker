rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Health / connectivity check
    match /test/{testId} {
      allow get: if true;
    }

    // 3. Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isMoritz() {
      return isSignedIn() && request.auth.token.email == 'moritz.menet.bfsu@gmail.com';
    }

    // RBAC: Check if user is an admin of the household
    // We check the 'allowed_emails' list in the household doc OR if they are Moritz
    function isHouseholdAdmin(householdId) {
      let household = get(/databases/$(database)/documents/households/$(householdId)).data;
      return isMoritz() || (isSignedIn() && request.auth.token.email in household.allowed_emails);
    }

    // Validation Blueprints
    function isValidHousehold(data) {
      return data.keys().hasAll(['id', 'household_name', 'categories']) &&
        data.keys().hasOnly(['id', 'household_name', 'categories', 'default_weekly_target', 'last_reset_date', 'color_theme', 'star_multiplier_1', 'star_multiplier_2', 'star_multiplier_3', 'rollover_factor', 'rollover_surplus_factor', 'rollover_deficit_factor', 'rollover_min_target', 'rollover_max_target', 'week_start_day', 'allowed_emails', 'updatedAt', 'firebase_url']) &&
        data.id is string && isValidId(data.id) &&
        data.household_name is string && data.household_name.size() <= 100 &&
        data.categories is list && data.categories.size() <= 50;
    }

    function isValidMember(data) {
      return data.keys().hasAll(['id', 'name', 'role', 'avatar_color']) &&
        data.keys().hasOnly(['id', 'name', 'role', 'avatar_color', 'total_points', 'weekly_target', 'householdId', 'has_seen_tutorial', 'pin_code']) &&
        data.id is string && isValidId(data.id) &&
        data.name is string && data.name.size() <= 100 &&
        data.role in ['admin', 'member'] &&
        data.avatar_color is string && data.avatar_color.matches('^#[0-9a-fA-F]{6}$') &&
        (data.pin_code == null || (data.pin_code is string && data.pin_code.size() <= 10));
    }

    function isValidTask(data) {
      return data.keys().hasAll(['id', 'title', 'category', 'base_points']) &&
        data.keys().hasOnly(['id', 'title', 'description', 'category', 'base_points', 'estimated_duration', 'interval_days', 'created_by', 'last_done', 'householdId']) &&
        data.id is string && isValidId(data.id) &&
        data.title is string && data.title.size() <= 200 &&
        data.base_points is int && data.base_points >= 0 && data.base_points <= 5000;
    }

    function isValidLog(data) {
      return data.keys().hasAll(['log_id', 'task_id', 'user_id', 'stars', 'points_awarded', 'timestamp']) &&
        data.keys().hasOnly(['log_id', 'task_id', 'user_id', 'stars', 'points_awarded', 'actual_duration', 'timestamp', 'notes', 'householdId']) &&
        data.log_id is string && isValidId(data.log_id) &&
        data.stars is int && data.stars >= 1 && data.stars <= 3 &&
        data.timestamp is string && data.timestamp.size() <= 50;
    }

    // 4. Match Blocks
    match /households/{householdId} {
      // Access: Any signed-in user can get/list (since it's a shared app with potential guest access via email)
      // BUT list is restricted by allowed_emails or Moritz
      allow get: if isSignedIn() && isValidId(householdId);
      allow list: if isMoritz(); // Only Moritz can list all households

      allow create: if isMoritz() && isValidId(householdId) && isValidHousehold(incoming());
      
      allow update: if (isMoritz() || isHouseholdAdmin(householdId)) 
                    && isValidId(householdId) 
                    && isValidHousehold(incoming())
                    && incoming().id == existing().id;

      allow delete: if isMoritz();

      // Subcollections
      match /members/{memberId} {
        allow read: if isSignedIn() && isValidId(householdId);
        allow create: if (isMoritz() || isHouseholdAdmin(householdId)) && isValidId(memberId) && isValidMember(incoming());
        allow update: if (isMoritz() || isHouseholdAdmin(householdId)) 
                      && isValidMember(incoming())
                      && incoming().id == existing().id;
        allow delete: if (isMoritz() || isHouseholdAdmin(householdId));
      }

      match /tasks/{taskId} {
        allow read: if isSignedIn() && isValidId(householdId);
        allow create: if (isMoritz() || isHouseholdAdmin(householdId)) && isValidId(taskId) && isValidTask(incoming());
        allow update: if (isMoritz() || isHouseholdAdmin(householdId)) 
                      && isValidTask(incoming())
                      && incoming().id == existing().id;
        allow delete: if (isMoritz() || isHouseholdAdmin(householdId));
      }

      match /logs/{logId} {
        allow read: if isSignedIn() && isValidId(householdId);
        allow create: if isSignedIn() && isValidId(householdId) && isValidId(logId) && isValidLog(incoming());
        
        // Members can only update their own logs, Admins can update all
        allow update: if (isMoritz() || isHouseholdAdmin(householdId) || (incoming().user_id == request.auth.uid))
                      && isValidLog(incoming())
                      && incoming().log_id == existing().log_id;
                      
        allow delete: if isMoritz() || isHouseholdAdmin(householdId);
      }
    }
  }
}
