rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -------------------------------------------------------------------------
    // GLOBAL HELPERS
    // -------------------------------------------------------------------------
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isVerified() {
      return isSignedIn() && (
        request.auth.token.email_verified == true || 
        request.auth.token.email.lower() == 'moritz.menet.bfsu@gmail.com'
      );
    }
    
    function isOwner(email) {
      return isVerified() && request.auth.token.email.lower() == email.lower();
    }
    
    function isAdmin() {
      return isVerified() && (
        request.auth.token.email.lower() == 'moritz.menet.bfsu@gmail.com' ||
        getHouseholdData('main_household').allowed_emails.hasAny([request.auth.token.email.lower()])
      );
    }

    function getHouseholdData(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId)).data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // -------------------------------------------------------------------------
    // VALIDATION HELPERS
    // -------------------------------------------------------------------------

    function isValidHousehold(data) {
      return data.keys().hasAll(['household_name', 'default_weekly_target', 'categories']) &&
             data.household_name is string && data.household_name.size() <= 100 &&
             data.default_weekly_target is number &&
             data.categories is list && data.categories.size() <= 50;
    }

    function isValidMember(data) {
      return data.keys().hasAll(['id', 'name', 'role']) &&
             data.name is string && data.name.size() <= 50 &&
             data.role in ['admin', 'member'];
    }

    function isValidTask(data) {
      return data.keys().hasAll(['id', 'title', 'category', 'base_points']) &&
             data.title is string && data.title.size() <= 200 &&
             data.base_points is number && data.base_points >= 0;
    }

    function isValidLog(data) {
      return data.keys().hasAll(['log_id', 'task_id', 'user_id', 'points_awarded', 'timestamp']) &&
             data.points_awarded is number &&
             data.timestamp is string; // App uses ISO strings
    }

    // -------------------------------------------------------------------------
    // SECURITY RULES
    // -------------------------------------------------------------------------

    // Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Households
    match /households/{householdId} {
      allow read: if isVerified();
      allow write: if isAdmin() && isValidHousehold(request.resource.data);

      // Members Subcollection
      match /members/{memberId} {
        allow read: if isVerified();
        allow create, update: if isVerified() && isValidMember(request.resource.data);
        allow delete: if isAdmin();
      }

      // Tasks Subcollection
      match /tasks/{taskId} {
        allow read: if isVerified();
        allow create, update: if isVerified() && isValidTask(request.resource.data);
        allow delete: if isAdmin();
      }

      // Logs Subcollection
      match /logs/{logId} {
        allow read: if isVerified();
        allow create: if isVerified() && isValidLog(request.resource.data);
        allow update: if isVerified() && isValidLog(request.resource.data);
        allow delete: if isAdmin();
      }
    }

    // Public Test Collection (for connectivity checks)
    match /test/{testId} {
      allow read, write: if isSignedIn();
    }
  }
}
