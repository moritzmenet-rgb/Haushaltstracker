rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -------------------------------------------------------------------------
    // GLOBAL HELPERS
    // -------------------------------------------------------------------------
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isVerified() {
      return isSignedIn() && (
        request.auth.token.email_verified == true || 
        request.auth.token.email.lower() == 'moritz.menet.bfsu@gmail.com'
      );
    }
    
    function isOwner(email) {
      return isVerified() && request.auth.token.email.lower() == email.lower();
    }
    
    function isMoritz() {
      return isVerified() && request.auth.token.email.lower() == 'moritz.menet.bfsu@gmail.com';
    }
    
    function isAdmin() {
      return isVerified() && (
        isMoritz() ||
        (exists(/databases/$(database)/documents/households/main_household) && 
         get(/databases/$(database)/documents/households/main_household).data.allowed_emails.hasAny([request.auth.token.email.lower()]))
      );
    }

    function getHouseholdData(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId)).data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // -------------------------------------------------------------------------
    // VALIDATION HELPERS
    // -------------------------------------------------------------------------

    function isValidHousehold(data) {
      // Relaxed validation to ensure initial seed works
      return data.household_name is string && 
             data.default_weekly_target is number;
    }

    function isValidMember(data) {
      return data.keys().hasAll(['id', 'name', 'role']) &&
             data.name is string && data.name.size() <= 50 &&
             data.role in ['admin', 'member'];
    }

    function isValidTask(data) {
      return data.keys().hasAll(['id', 'title', 'category', 'base_points']) &&
             data.title is string && data.title.size() <= 200 &&
             data.base_points is number && data.base_points >= 0;
    }

    function isValidLog(data) {
      return data.keys().hasAll(['log_id', 'task_id', 'user_id', 'points_awarded', 'timestamp']) &&
             data.points_awarded is number &&
             data.timestamp is string; // App uses ISO strings
    }

    // -------------------------------------------------------------------------
    // SECURITY RULES
    // -------------------------------------------------------------------------

    // Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Households
    match /households/{householdId} {
      allow read: if isVerified();
      
      // Allow creation if Moritz or Admin
      allow create: if isVerified() && (isMoritz() || isAdmin());
      
      // Allow update if Admin and schema is basically okay
      allow update: if (isMoritz() || isAdmin()) && isValidHousehold(request.resource.data);
      
      allow delete: if isMoritz();

      // Members Subcollection
      match /members/{memberId} {
        allow read: if isVerified();
        allow create, update: if isVerified() && isValidMember(request.resource.data);
        allow delete: if isAdmin();
      }

      // Tasks Subcollection
      match /tasks/{taskId} {
        allow read: if isVerified();
        allow create, update: if isVerified() && isValidTask(request.resource.data);
        allow delete: if isAdmin();
      }

      // Logs Subcollection
      match /logs/{logId} {
        allow read: if isVerified();
        allow create: if isVerified() && isValidLog(request.resource.data);
        allow update: if isVerified() && isValidLog(request.resource.data);
        allow delete: if isAdmin();
      }
    }

    // Public Test Collection (for connectivity checks)
    match /test/{testId} {
      allow read, write: if isSignedIn();
    }
  }
}
