{
  "entities": {
    "Household": {
      "title": "Household",
      "description": "Root document for a family household containing settings and configuration.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "household_name": { "type": "string" },
        "default_weekly_target": { "type": "integer" },
        "categories": { "type": "array" },
        "last_reset_date": { "type": "string", "format": "date-time" },
        "color_theme": { "type": "string" },
        "star_multiplier_1": { "type": "integer" },
        "star_multiplier_2": { "type": "integer" },
        "star_multiplier_3": { "type": "integer" },
        "rollover_surplus_factor": { "type": "integer" },
        "rollover_deficit_factor": { "type": "integer" },
        "rollover_min_target": { "type": "integer" },
        "rollover_max_target": { "type": "integer" },
        "week_start_day": { "type": "string" },
        "allowed_emails": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "household_name", "categories"]
    },
    "Member": {
      "title": "Family Member",
      "description": "A profile within a household.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "avatar_color": { "type": "string" },
        "total_points": { "type": "integer" },
        "weekly_target": { "type": "integer" },
        "householdId": { "type": "string" },
        "has_seen_tutorial": { "type": "boolean" },
        "pin_code": { "type": "string" }
      },
      "required": ["id", "name", "role", "avatar_color"]
    },
    "Task": {
      "title": "Task",
      "description": "A chore definition.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "base_points": { "type": "integer" },
        "estimated_duration": { "type": "integer" },
        "interval_days": { "type": "integer" },
        "created_by": { "type": "string" },
        "last_done": { "type": "string", "format": "date-time" },
        "householdId": { "type": "string" }
      },
      "required": ["id", "title", "category", "base_points"]
    },
    "Log": {
      "title": "Chore Log",
      "description": "A record of a completed chore.",
      "type": "object",
      "properties": {
        "log_id": { "type": "string" },
        "task_id": { "type": "string" },
        "user_id": { "type": "string" },
        "stars": { "type": "integer" },
        "points_awarded": { "type": "integer" },
        "actual_duration": { "type": "integer" },
        "timestamp": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" },
        "householdId": { "type": "string" }
      },
      "required": ["log_id", "task_id", "user_id", "stars", "points_awarded", "timestamp"]
    }
  },
  "firestore": {
    "/households/{householdId}": {
      "schema": "Household",
      "description": "Primary household settings"
    },
    "/households/{householdId}/members/{memberId}": {
      "schema": "Member",
      "description": "Profiles within the household"
    },
    "/households/{householdId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "Chore definitions for the household"
    },
    "/households/{householdId}/logs/{logId}": {
      "schema": "Log",
      "description": "Completed chore history"
    }
  }
}
