{
  "entities": {
    "Household": {
      "title": "Household",
      "description": "Root document for a family household containing settings and configuration.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "household_name": { "type": "string", "maxLength": 100 },
        "default_weekly_target": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "categories": { "type": "array", "maxItems": 50 },
        "last_reset_date": { "type": "string", "format": "date-time" },
        "last_scheduled_run": { "type": "string", "format": "date-time" },
        "color_theme": { "type": "string", "enum": ["indigo", "emerald", "rose", "amber", "daily", "cyberpunk", "sunset", "forest"] },
        "star_multiplier_1": { "type": "integer" },
        "star_multiplier_2": { "type": "integer" },
        "star_multiplier_3": { "type": "integer" },
        "rollover_factor": { "type": "integer" },
        "rollover_surplus_factor": { "type": "integer" },
        "rollover_deficit_factor": { "type": "integer" },
        "rollover_min_target": { "type": "integer" },
        "rollover_max_target": { "type": "integer" },
        "week_start_day": { "type": "string", "enum": ["monday", "sunday", "saturday"] },
        "allowed_emails": { "type": "array", "maxItems": 100 },
        "blocked_emails": { "type": "array", "maxItems": 100 },
        "auto_reset_enabled": { "type": "boolean" },
        "scheduled_reset_day": { "type": "integer", "minimum": 0, "maximum": 6 },
        "scheduled_reset_hour": { "type": "integer", "minimum": 0, "maximum": 23 },
        "scheduled_reset_minute": { "type": "integer", "minimum": 0, "maximum": 59 },
        "updatedAt": { "type": "string", "format": "date-time" },
        "firebase_url": { "type": "string", "maxLength": 255 }
      },
      "required": ["id", "household_name", "categories"]
    },
    "Member": {
      "title": "Family Member",
      "description": "A profile within a household.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["admin", "member"] },
        "avatar_color": { "type": "string" },
        "total_points": { "type": "integer" },
        "weekly_target": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "householdId": { "type": "string" },
        "has_seen_tutorial": { "type": "boolean" },
        "last_seen_version": { "type": "string", "maxLength": 64 },
        "preferred_theme": { "type": "string", "maxLength": 32 },
        "preferred_mode": { "type": "string", "maxLength": 32 },
        "haptics_enabled": { "type": "boolean" },
        "animations_enabled": { "type": "boolean" },
        "pin_code": { "type": "string", "maxLength": 32 },
        "unlocked_badges": { "type": "object" },
        "showroom_badges": { "type": "array", "maxItems": 20 },
        "active_badge_id": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "name", "role", "avatar_color"]
    },
    "Task": {
      "title": "Task",
      "description": "A chore definition.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "category": { "type": "string", "maxLength": 100 },
        "base_points": { "type": "integer", "minimum": -500, "maximum": 5000 },
        "estimated_duration": { "type": "integer", "minimum": 0, "maximum": 1440 },
        "interval_days": { "type": "integer", "minimum": 0, "maximum": 365 },
        "frequency_per_day": { "type": "integer", "minimum": 1, "maximum": 10 },
        "preferred_time": { "type": "string" },
        "created_by": { "type": "string" },
        "last_done": { "type": "string" },
        "fished_by": { "type": "string" },
        "fished_until": { "type": "string" },
        "is_pinned": { "type": "boolean" },
        "pinned_bonus_points": { "type": "integer", "minimum": 0, "maximum": 5000 },
        "householdId": { "type": "string" }
      },
      "required": ["id", "title", "category", "base_points"]
    },
    "Log": {
      "title": "Chore Log",
      "description": "A record of a completed chore.",
      "type": "object",
      "properties": {
        "log_id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "task_id": { "type": "string" },
        "user_id": { "type": "string" },
        "stars": { "type": "integer", "minimum": 1, "maximum": 3 },
        "points_awarded": { "type": "integer" },
        "actual_duration": { "type": "integer" },
        "timestamp": { "type": "string" },
        "notes": { "type": "string", "maxLength": 2000 },
        "householdId": { "type": "string" }
      },
      "required": ["log_id", "task_id", "user_id", "stars", "points_awarded", "timestamp"]
    },
    "PinnwandNote": {
      "title": "Pinnwand Note",
      "description": "A sticky note (post-it) on the family bulletin board with threads, polls, and reactions.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "rootId": { "type": "string" },
        "parentId": { "type": "string" },
        "depth": { "type": "integer", "minimum": 0, "maximum": 20 },
        "title": { "type": "string", "maxLength": 300 },
        "content": { "type": "string", "maxLength": 5000 },
        "color": { "type": "string", "enum": ["yellow", "pink", "blue", "green", "orange", "purple"] },
        "category": { "type": "string", "maxLength": 100 },
        "authorId": { "type": "string" },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorAvatarColor": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "isPinned": { "type": "boolean" },
        "reactions": { "type": "object" },
        "poll": { "type": "object" },
        "position": { "type": "object" },
        "rotation": { "type": "number" },
        "householdId": { "type": "string" }
      },
      "required": ["id", "content", "color", "authorId", "authorName", "createdAt"]
    },
    "MenuPlan": {
      "title": "Menu Plan",
      "description": "Planned meals for a given day.",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "lunch": { "type": "object" },
        "dinner": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["date"]
    },
    "MenuWish": {
      "title": "Menu Wish",
      "description": "Meal idea or recipe request submitted by family members.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "requestedBy": { "type": "string" },
        "requestedByName": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "upvotes": { "type": "array" },
        "planned": { "type": "boolean" }
      },
      "required": ["id", "title", "requestedBy", "createdAt"]
    },
    "Notification": {
      "title": "Household Notification",
      "description": "Real-time notification for pinned tasks or stolen Wanderpokale.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["task_pinned", "trophy_stolen", "general"] },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "icon": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "targetUserId": { "type": "string" },
        "oldOwnerName": { "type": "string" },
        "newOwnerName": { "type": "string" },
        "trophyTitle": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "type", "title", "message", "timestamp"]
    }
  },
  "firestore": {
    "/households/{householdId}": {
      "schema": "Household",
      "description": "Primary household settings"
    },
    "/households/{householdId}/members/{memberId}": {
      "schema": "Member",
      "description": "Profiles within the household"
    },
    "/households/{householdId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "Chore definitions for the household"
    },
    "/households/{householdId}/logs/{logId}": {
      "schema": "Log",
      "description": "Completed chore history"
    },
    "/households/{householdId}/pinnwand/{noteId}": {
      "schema": "PinnwandNote",
      "description": "Sticky notes, threads, and polls on the family corkboard"
    },
    "/households/{householdId}/menus/{menuId}": {
      "schema": "MenuPlan",
      "description": "Day menu planner subcollection"
    },
    "/households/{householdId}/menu_wishes/{wishId}": {
      "schema": "MenuWish",
      "description": "Meal wishes and requests"
    },
    "/households/{householdId}/recipes/{recipeId}": {
      "schema": "object",
      "description": "Saved family recipes"
    },
    "/households/{householdId}/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Household notifications for pinned tasks and stolen trophies"
    },
    "/sessions/{sessionId}": {
      "schema": "object",
      "description": "User login session logs"
    },
    "/test/{testId}": {
      "schema": "object",
      "description": "Connection test collection"
    }
  }
}
