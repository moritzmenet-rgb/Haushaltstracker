{
  "entities": {
    "Household": {
      "title": "Household",
      "description": "Root document for a family household containing settings and configuration.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "household_name": { "type": "string", "maxLength": 100 },
        "default_weekly_target": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "categories": { "type": "array", "maxItems": 50 },
        "last_reset_date": { "type": "string", "format": "date-time" },
        "color_theme": { "type": "string", "enum": ["indigo", "emerald", "rose", "amber"] },
        "star_multiplier_1": { "type": "integer" },
        "star_multiplier_2": { "type": "integer" },
        "star_multiplier_3": { "type": "integer" },
        "rollover_factor": { "type": "integer" },
        "rollover_surplus_factor": { "type": "integer" },
        "rollover_deficit_factor": { "type": "integer" },
        "rollover_min_target": { "type": "integer" },
        "rollover_max_target": { "type": "integer" },
        "week_start_day": { "type": "string", "enum": ["monday", "sunday", "saturday"] },
        "allowed_emails": { "type": "array", "maxItems": 100 },
        "updatedAt": { "type": "string", "format": "date-time" },
        "firebase_url": { "type": "string", "maxLength": 255 }
      },
      "required": ["id", "household_name", "categories"]
    },
    "Member": {
      "title": "Family Member",
      "description": "A profile within a household.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["admin", "member"] },
        "avatar_color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "total_points": { "type": "integer" },
        "weekly_target": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "householdId": { "type": "string" },
        "has_seen_tutorial": { "type": "boolean" },
        "pin_code": { "type": "string", "maxLength": 10 }
      },
      "required": ["id", "name", "role", "avatar_color"]
    },
    "Task": {
      "title": "Task",
      "description": "A chore definition.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "category": { "type": "string", "maxLength": 100 },
        "base_points": { "type": "integer", "minimum": 0, "maximum": 5000 },
        "estimated_duration": { "type": "integer", "minimum": 0, "maximum": 1440 },
        "interval_days": { "type": "integer", "minimum": 0, "maximum": 365 },
        "frequency_per_day": { "type": "integer", "minimum": 1, "maximum": 10 },
        "preferred_time": { "type": "string", "enum": ["morning", "noon", "evening"] },
        "created_by": { "type": "string" },
        "last_done": { "type": "string", "format": "date-time" },
        "fished_by": { "type": "string" },
        "fished_until": { "type": "string", "format": "date-time" },
        "householdId": { "type": "string" }
      },
      "required": ["id", "title", "category", "base_points"]
    },
    "Log": {
      "title": "Chore Log",
      "description": "A record of a completed chore.",
      "type": "object",
      "properties": {
        "log_id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "task_id": { "type": "string" },
        "user_id": { "type": "string" },
        "stars": { "type": "integer", "minimum": 1, "maximum": 3 },
        "points_awarded": { "type": "integer" },
        "actual_duration": { "type": "integer" },
        "timestamp": { "type": "string", "format": "date-time" },
        "notes": { "type": "string", "maxLength": 2000 },
        "householdId": { "type": "string" }
      },
      "required": ["log_id", "task_id", "user_id", "stars", "points_awarded", "timestamp"]
    },
    "PinnwandNote": {
      "title": "Pinnwand Note",
      "description": "A sticky note (post-it) on the family bulletin board with threads, polls, and reactions.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "rootId": { "type": "string" },
        "parentId": { "type": "string" },
        "depth": { "type": "integer", "minimum": 0, "maximum": 20 },
        "title": { "type": "string", "maxLength": 300 },
        "content": { "type": "string", "maxLength": 5000 },
        "color": { "type": "string", "enum": ["yellow", "pink", "blue", "green", "orange", "purple"] },
        "category": { "type": "string", "maxLength": 100 },
        "authorId": { "type": "string" },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorAvatarColor": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "isPinned": { "type": "boolean" },
        "householdId": { "type": "string" }
      },
      "required": ["id", "content", "color", "authorId", "authorName", "createdAt"]
    }
  },
  "firestore": {
    "/households/{householdId}": {
      "schema": "Household",
      "description": "Primary household settings"
    },
    "/households/{householdId}/members/{memberId}": {
      "schema": "Member",
      "description": "Profiles within the household"
    },
    "/households/{householdId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "Chore definitions for the household"
    },
    "/households/{householdId}/logs/{logId}": {
      "schema": "Log",
      "description": "Completed chore history"
    },
    "/households/{householdId}/pinnwand/{noteId}": {
      "schema": "PinnwandNote",
      "description": "Sticky notes, threads, and polls on the family corkboard"
    }
  }
}
